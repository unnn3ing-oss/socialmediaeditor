{
  "id": "ytdl",
  "name": "YT 批量下載",
  "group": "發文與素材",
  "desc": "公司 YouTube／IG Reel 公開影片批量下載到本機（720p／1080p）",
  "icon": "icon.svg",
  "thumb": "thumb.svg",
  "entry": "index.html",
  "tier": "public",
  "requires": ["extension", "helper"],
  "assets": {},
  "ext": {
    "permissions": ["downloads", "nativeMessaging", "scripting"],
    "hosts": [
      "https://i.ytimg.com/*",
      "https://instagram.com/*",
      "https://m.youtube.com/*",
      "https://music.youtube.com/*",
      "https://www.instagram.com/*",
      "https://www.youtube.com/*",
      "https://youtu.be/*"
    ],
    "dir": "ext",
    "background": "ext/index.js"
  },
  "api": null,
  "sdk": 1
}
