{
  "manifest_version": 3,
  "name": "小編工具箱",
  "version": "1.01",
  "key": "",
  "permissions": [
    "alarms",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "core/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://unnn3ing-oss.github.io/socialmediaeditor/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "core/bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "core/sidepanel.html"
  },
  "action": {
    "default_title": "小編工具箱"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
